
---
import { UNCATEGORIZED } from "@constants/constants";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { getSortedPosts } from "../utils/content-utils";
import { url, getPostUrlBySlug } from "../utils/url-utils";

interface Props {
    keyword?: string;
    tags?: string[];
    categories?: string[];
}

const { tags, categories } = Astro.props;

let posts = await getSortedPosts();

if (Array.isArray(tags) && tags.length > 0) {
    posts = posts.filter(
        (post) =>
            Array.isArray(post.data.tags) &&
            post.data.tags.some((tag) => tags.includes(tag)),
    );
}

if (Array.isArray(categories) && categories.length > 0) {
    posts = posts.filter(
        (post) =>
            (post.data.category && categories.includes(post.data.category)) ||
            (!post.data.category && categories.includes(UNCATEGORIZED)),
    );
}

const isCoursesCategory =
    Array.isArray(categories) &&
    categories.length === 1 &&
    categories[0] === "Courses Notes";

/*
 * Courses
 */

const coursePosts = posts.filter(
    (post) => post.data.category === "Courses Notes" && post.data.course,
);

const individualCoursePosts = posts.filter(
    (post) => post.data.category === "Courses Notes" && !post.data.course,
);

const standalonePosts = posts.filter(
    (post) => post.data.category !== "Courses Notes",
);

const courseDescription = "Learn. Practice. Master.";

/*
 * Course Cover Images
 */

function getCourseImage(courseName: string): string {
    const name = courseName.toLowerCase().replace(/[^a-z0-9]/g, "");

    if (name.includes("emapt")) return "/images/course-covers/eMAPT.png";
    if (name.includes("eais")) return "/images/course-covers/eAIS.png";
    if (name.includes("oscp")) return "/images/course-covers/OSCP-plus.png";
    if (name.includes("ceh")) return "/images/course-covers/CEHv13.png";
    if (name.includes("ewptx")) return "/images/course-covers/eWPTXv3.png";
    if (name.includes("cysa")) return "/images/course-covers/CySA-plus.png";
    if (name.includes("ecthp")) return "/images/course-covers/eCTHPv3.png";
    if (name.includes("ecir")) return "/images/course-covers/eCIR.png";
    if (name.includes("security")) return "/images/course-covers/Security-plus.png";
    if (name.includes("ejpt")) return "/images/course-covers/eJPTv2.png";
    if (name.includes("ewptv2")) return "/images/course-covers/eWPTv2.png";

    return "/images/course-covers/eMAPT.png";
}

/*
 * Course URLs
 */

function getCourseUrl(courseName: string): string {
    const normalizedName = courseName
        .toLowerCase()
        .replace(/[^a-z0-9]/g, "");

    if (normalizedName.includes("emapt")) {
        return url("/courses/emapt/index.html");
    }

    if (normalizedName.includes("oscp")) {
        return url("/courses/oscp/");
    }

    if (normalizedName.includes("cehv13")) {
        return url("/courses/cehv13/");
    }

    if (normalizedName.includes("ewptxv3")) {
        return url("/courses/ewptxv3/");
    }

    return url(`/courses/${normalizedName}/`);
}

/*
 * Build Course Cards
 */

const courses = isCoursesCategory ? [
    ...Array.from(
        new Set(
            coursePosts
                .map((post) => post.data.course)
                .filter((course): course is string => Boolean(course)),
        ),
    ).map((course) => {
        const modules = coursePosts
            .filter((post) => post.data.course === course)
            .sort((a, b) => (a.data.module ?? 999) - (b.data.module ?? 999));

        return {
            name: course,
            image: getCourseImage(course),
            modules,
            href: getCourseUrl(course),
            description: courseDescription,
            countLabel: "Modules Available",
        };
    }),

    {
        name: "OSCP+",
        image: getCourseImage("OSCP+"),
        modules: Array.from({ length: 17 }, (_, i) => i + 1),
        href: url("/courses/oscp/"),
        description: courseDescription,
        countLabel: "Modules Available",
    },

    {
        name: "CEHv13",
        image: getCourseImage("CEHv13"),
        modules: Array.from({ length: 17 }, (_, i) => i + 1),
        href: url("/courses/cehv13/"),
        description: courseDescription,
        countLabel: "Modules Available",
    },

    {
        name: "eWPTXv3",
        image: getCourseImage("eWPTXv3"),
        modules: Array.from({ length: 6 }, (_, i) => i + 1),
        href: url("/courses/ewptxv3/"),
        description: courseDescription,
        countLabel: "Modules Available",
    },

    ...individualCoursePosts.map((post) => ({
        name: post.data.title,
        image: getCourseImage(post.data.title),
        modules: [post],
        href: getPostUrlBySlug(post.slug),
        description: courseDescription,
        countLabel: "Note Available",
    })),
] : [];

const standaloneCourses = ["OSCP+", "CEHv13", "eWPTXv3", "eMAPT"];

/*
 * Timeline Groups
 */

const groups: { year: number; posts: typeof standalonePosts }[] = (() => {
    const groupedPosts = standalonePosts.reduce(
        (grouped: { [year: number]: typeof standalonePosts }, post) => {
            const year = post.data.published.getFullYear();

            if (!grouped[year]) {
                grouped[year] = [];
            }

            grouped[year].push(post);

            return grouped;
        },
        {},
    );

    const groupedPostsArray = Object.keys(groupedPosts).map((key) => ({
        year: Number.parseInt(key),
        posts: groupedPosts[Number.parseInt(key)],
    }));

    groupedPostsArray.sort((a, b) => b.year - a.year);

    return groupedPostsArray;
})();

function formatDate(date: Date) {
    const month = (date.getMonth() + 1).toString().padStart(2, "0");
    const day = (date.getDate() + 1).toString().padStart(2, "0");

    return `${month}-${day}`;
}

function formatTag(tag: string[] = []) {
    return tag.map((t) => `#${t}`).join(" ");
}
---

<div class="card-base px-5 py-6 md:px-8">

    {
        courses.length > 0 && (
            <div class="mb-8">
                <div class="flex flex-row w-full items-center h-[3.75rem] mb-4">
                    <div class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75">
                        Courses
                    </div>

                    <div class="w-[15%] md:w-[10%]">
                        <div class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto -outline-offset-[2px] z-50 outline-3"></div>
                    </div>

                    <div class="w-[70%] md:w-[80%] transition text-left text-50">
                        {courses.length} Courses
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 items-stretch">
                    {courses.map((course) => (
                        <a
                            href={course.href}
                            aria-label={`${course.name} Course`}
                            data-no-swup={
                                standaloneCourses.includes(course.name) ||
                                course.href.includes("/courses/emapt/")
                                    ? ""
                                    : undefined
                            }
                            class="group btn-plain !block w-full h-full rounded-xl hover:text-[initial]"
                        >
                            <div class="flex flex-col h-full min-h-[330px] overflow-hidden rounded-xl border border-[var(--line-color)] transition-all duration-300 group-hover:border-[var(--primary)] group-hover:bg-[var(--btn-plain-bg-hover)]">
                                <div class="relative w-full h-40 overflow-hidden bg-[var(--btn-plain-bg-hover)]">
                                    <img
                                        src={course.image}
                                        alt={`${course.name} Study Notes Cover`}
                                        loading="lazy"
                                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                    />
                                </div>

                                <div class="flex flex-col flex-1 justify-between p-4">
                                    <div>
                                        <div class="flex items-center gap-3">
                                            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[var(--btn-plain-bg-hover)] font-bold text-xs group-hover:bg-[var(--primary)] group-hover:text-white transition-all">
                                                {course.name}
                                            </div>

                                            <div class="font-bold text-lg text-75 group-hover:text-[var(--primary)] transition-all">
                                                {course.name}
                                            </div>
                                        </div>

                                        <div class="mt-4">
                                            <div class="text-sm text-50 leading-relaxed">
                                                {course.description}
                                            </div>

                                            <div class="text-xs text-30 mt-2">
                                                {course.modules.length} {course.countLabel}
                                            </div>
                                        </div>
                                    </div>

                                    <div class="flex justify-end items-center mt-4 text-sm text-30 group-hover:text-[var(--primary)] transition-all">
                                        View Course →
                                    </div>
                                </div>
                            </div>
                        </a>
                    ))}
                </div>
            </div>
        )
    }

    {
        groups.map((group) => (
            <div>
                <div class="flex flex-row w-full items-center h-[3.75rem]">
                    <div class="w-[15%] md:w-[10%] transition text-2xl font-bold text-right text-75">
                        {group.year}
                    </div>

                    <div class="w-[15%] md:w-[10%]">
                        <div class="h-3 w-3 bg-none rounded-full outline outline-[var(--primary)] mx-auto -outline-offset-[2px] z-50 outline-3"></div>
                    </div>

                    <div class="w-[70%] md:w-[80%] transition text-left text-50">
                        {group.posts.length} {i18n(I18nKey.postsCount)}
                    </div>
                </div>

                {group.posts.map((post) => (
                    <a
                        href={getPostUrlBySlug(post.slug)}
                        aria-label={post.data.title}
                        class="group btn-plain !block h-10 w-full rounded-lg hover:text-[initial]"
                    >
                        <div class="flex flex-row justify-start items-center h-full">
                            <div class="w-[15%] md:w-[10%] transition text-sm text-right text-50">
                                {formatDate(post.data.published)}
                            </div>

                            <div class="w-[15%] md:w-[10%] relative dash-line h-full flex items-center">
                                <div
                                    class="transition-all mx-auto w-1 h-1 rounded group-hover:h-5
                                    bg-[oklch(0.5_0.05_var(--hue))] group-hover:bg-[var(--primary)]
                                    outline outline-4 z-50
                                    outline-[var(--card-bg)]
                                    group-hover:outline-[var(--btn-plain-bg-hover)]
                                    group-active:outline-[var(--btn-plain-bg-active)]"
                                ></div>
                            </div>

                            <div
                                class="w-[70%] md:max-w-[65%] md:w-[65%] text-left font-bold
                                group-hover:translate-x-1 transition-all group-hover:text-[var(--primary)]
                                text-75 pr-8 whitespace-nowrap overflow-ellipsis overflow-hidden"
                            >
                                {post.data.title}
                            </div>

                            <div
                                class="hidden md:block md:w-[15%] text-left text-sm transition
                                whitespace-nowrap overflow-ellipsis overflow-hidden
                                text-30"
                            >
                                {formatTag(post.data.tags)}
                            </div>
                        </div>
                    </a>
                ))}
            </div>
        ))
    }
</div>
