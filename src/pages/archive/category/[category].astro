
---
import ArchivePanel from "@components/ArchivePanel.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCategoryList } from "@utils/content-utils";

export async function getStaticPaths() {
    const categories = await getCategoryList();

    return categories.map((category) => ({
        params: {
            category: category.name,
        },
    }));
}

const category = Astro.params.category as string;
const isExamSimulation = category === "eXam Simulation";

const examUrl = "/exams/cehv13/index.html";
const practiceUrl = "/exams/cehv13-practice/index.html";

const networkExamUrl = "/exams/network-plus/";
const networkPracticeUrl = "/exams/network-plus-practice/";

const securityExamUrl = "/exams/security-plus/";
const securityPracticeUrl = "/exams/security-plus-practice/";
---

<MainGridLayout
    title={isExamSimulation ? "Cybersecurity Exam Simulations" : i18n(I18nKey.archive)}
    description={isExamSimulation ? "Professional Certification Examination Simulations" : i18n(I18nKey.archive)}
>
    {isExamSimulation ? (
        <main class="exam-page">
            <section class="hero">
                <div class="hero-content">
                    <div class="eyebrow">
                        <span class="status-dot"></span>
                        EXAM SIMULATION
                    </div>

                    <p class="course-label">CYBERSECURITY · CERTIFICATION EXAMS</p>

                    <h1>
                        Test Your Cybersecurity
                        <span>Knowledge & Skills</span>
                    </h1>

                    <p class="hero-description">
                        Challenge yourself with realistic certification exam
                        simulations. Evaluate your knowledge, test your skills,
                        and measure your readiness for professional certifications.
                    </p>

                    <div class="hero-actions">
                        <a
                            href="#exam-options"
                            class="start-button"
                        >
                            Explore Examinations <span>↓</span>
                        </a>

                        <span class="secure-label">◈ Online Exam Simulations</span>
                    </div>
                </div>

                <div class="hero-visual">
                    <div class="visual-glow"></div>

                    <div class="exam-emblem">
                        <div class="emblem-top">EXAM</div>
                        <div class="emblem-number">SIMULATOR</div>
                        <div class="emblem-line"></div>
                        <div class="emblem-caption">TEST YOUR KNOWLEDGE</div>
                    </div>

                    <div class="floating-tag tag-top">6 EXAMS</div>
                    <div class="floating-tag tag-bottom">3 CERTIFICATIONS</div>
                </div>
            </section>

            <!-- Examination Options -->
            <section class="exam-options" id="exam-options">
                <div class="section-heading">
                    <span class="section-kicker">AVAILABLE EXAMINATIONS</span>
                    <h2>Choose Your <span>Certification</span></h2>
                    <p>Select an examination simulator or practice test to get started.</p>
                </div>

                <!-- CEHv13 -->
                <div class="certification-group">
                    <div class="certification-heading">
                        <span class="certification-index">01</span>
                        <div>
                            <h3>CEHv13</h3>
                            <p>Certified Ethical Hacker · EC-Council</p>
                        </div>
                    </div>

                    <div class="exam-options-grid">
                        <article class="exam-option-card">
                            <div class="option-top">
                                <span class="option-number">01</span>
                                <span class="option-label">EXAM SIMULATOR</span>
                            </div>

                            <h3>CEHv13 Exam Simulator</h3>

                            <p>
                                Test your cybersecurity knowledge with the CEHv13
                                examination simulation and evaluate your readiness.
                            </p>

                            <a
                                href={examUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                data-no-swup
                                class="start-button"
                            >
                                Start Examination <span>→</span>
                            </a>
                        </article>

                        <article class="exam-option-card practice-card">
                            <div class="option-top">
                                <span class="option-number">02</span>
                                <span class="option-label">PRACTICE EXAM</span>
                            </div>

                            <h3>CEHv13 Practice</h3>

                            <p>
                                Take the additional practice exam to challenge
                                your knowledge and strengthen your preparation.
                            </p>

                            <a
                                href={practiceUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                data-no-swup
                                class="start-button"
                            >
                                Start Practice <span>→</span>
                            </a>
                        </article>
                    </div>
                </div>

                <!-- Network+ -->
                <div class="certification-group">
                    <div class="certification-heading">
                        <span class="certification-index">02</span>
                        <div>
                            <h3>CompTIA Network+</h3>
                            <p>Networking Certification</p>
                        </div>
                    </div>

                    <div class="exam-options-grid">
                        <article class="exam-option-card">
                            <div class="option-top">
                                <span class="option-number">03</span>
                                <span class="option-label">EXAM SIMULATOR</span>
                            </div>

                            <h3>Network+ Exam Simulator</h3>

                            <p>
                                Assess your networking knowledge, including network
                                infrastructure, operations, troubleshooting, and security.
                            </p>

                            <a
                                href={networkExamUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                data-no-swup
                                class="start-button"
                            >
                                Start Examination <span>→</span>
                            </a>
                        </article>

                        <article class="exam-option-card practice-card">
                            <div class="option-top">
                                <span class="option-number">04</span>
                                <span class="option-label">PRACTICE EXAM</span>
                            </div>

                            <h3>Network+ Practice</h3>

                            <p>
                                Strengthen your networking skills with additional
                                practice questions and test your exam readiness.
                            </p>

                            <a
                                href={networkPracticeUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                data-no-swup
                                class="start-button"
                            >
                                Start Practice <span>→</span>
                            </a>
                        </article>
                    </div>
                </div>

                <!-- Security+ -->
                <div class="certification-group">
                    <div class="certification-heading">
                        <span class="certification-index">03</span>
                        <div>
                            <h3>CompTIA Security+</h3>
                            <p>Cybersecurity Certification · SY0-701</p>
                        </div>
                    </div>

                    <div class="exam-options-grid">
                        <article class="exam-option-card">
                            <div class="option-top">
                                <span class="option-number">05</span>
                                <span class="option-label">EXAM SIMULATOR</span>
                            </div>

                            <h3>Security+ Exam Simulator</h3>

                            <p>
                                Test your understanding of cybersecurity concepts,
                                threats, vulnerabilities, and security controls.
                            </p>

                            <a
                                href={securityExamUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                data-no-swup
                                class="start-button"
                            >
                                Start Examination <span>→</span>
                            </a>
                        </article>

                        <article class="exam-option-card practice-card">
                            <div class="option-top">
                                <span class="option-number">06</span>
                                <span class="option-label">PRACTICE EXAM</span>
                            </div>

                            <h3>Security+ Practice</h3>

                            <p>
                                Improve your security knowledge and prepare for
                                the CompTIA Security+ certification exam.
                            </p>

                            <a
                                href={securityPracticeUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                data-no-swup
                                class="start-button"
                            >
                                Start Practice <span>→</span>
                            </a>
                        </article>
                    </div>
                </div>
            </section>

            <section class="stats">
                <div class="stat-card">
                    <span class="stat-icon">◈</span>
                    <strong>03</strong>
                    <span>Certifications</span>
                </div>

                <div class="stat-card">
                    <span class="stat-icon">◷</span>
                    <strong>06</strong>
                    <span>Available Exams</span>
                </div>

                <div class="stat-card">
                    <span class="stat-icon">◎</span>
                    <strong>03</strong>
                    <span>Exam Simulators</span>
                </div>

                <div class="stat-card">
                    <span class="stat-icon">✧</span>
                    <strong>03</strong>
                    <span>Practice Exams</span>
                </div>
            </section>

            <section class="rules-section">
                <div class="section-heading">
                    <span class="section-kicker">BEFORE YOU BEGIN</span>
                    <h2>Examination <span>Guidelines</span></h2>
                    <p>Please review these general guidelines before starting an exam.</p>
                </div>

                <div class="rules-grid">
                    <article class="rule-card">
                        <div class="rule-icon">⌁</div>
                        <h3>No Copy & Paste</h3>
                        <p>Follow the examination rules regarding copying and pasting.</p>
                    </article>

                    <article class="rule-card warning">
                        <div class="rule-icon">⚠</div>
                        <h3>Stay on Exam Tab</h3>
                        <p>Some simulations may apply restrictions when leaving the examination tab.</p>
                    </article>

                    <article class="rule-card">
                        <div class="rule-icon">◷</div>
                        <h3>Time Limit</h3>
                        <p>Check the examination instructions for the time limit of each exam.</p>
                    </article>

                    <article class="rule-card">
                        <div class="rule-icon">✧</div>
                        <h3>Review Your Results</h3>
                        <p>Review your performance after completing the examination.</p>
                    </article>
                </div>
            </section>

            <section class="passing-section">
                <div class="passing-content">
                    <span class="section-kicker">YOUR NEXT CHALLENGE</span>
                    <h2>Are you ready to <span>prove your skills?</span></h2>

                    <p>
                        Choose your certification, prepare yourself, and challenge
                        your knowledge through our online examination simulations.
                    </p>
                </div>

                <div class="passing-score">
                    <strong>6<span></span></strong>
                    <small>AVAILABLE EXAMS</small>
                </div>
            </section>

            <section class="final-cta" id="exam-access">
                <span class="section-kicker">CYBERSECURITY · EXAM SIMULATIONS</span>

                <h2>Your challenge starts here.</h2>

                <p>Choose your certification and start testing your knowledge.</p>

                <a href="#exam-options" class="start-button">
                    Explore All Exams <span>→</span>
                </a>

                <small>CEHv13 · Network+ · Security+</small>
            </section>
        </main>
    ) : (
        <ArchivePanel categories={[category]} />
    )}
</MainGridLayout>

<style>
    .exam-page {
        --wine: #8e2445;
        --wine-light: #c04468;
        --muted: #a9a1a8;
        color: var(--font-color);
        padding: 28px 0 55px;
    }

    .hero {
        position: relative;
        overflow: hidden;
        display: grid;
        grid-template-columns: 1.35fr .85fr;
        align-items: center;
        gap: 25px;
        min-height: 390px;
        padding: 48px;
        border: 1px solid rgba(192,68,104,.24);
        border-radius: 22px;
        background:
            radial-gradient(ellipse at 85% 50%, rgba(142,36,69,.35), transparent 55%),
            linear-gradient(120deg, #171318, #24131d 65%, #351421);
    }

    .hero-content { position: relative; z-index: 2; }

    .eyebrow, .course-label, .section-kicker {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 13px;
        border: 1px solid rgba(192,68,104,.35);
        border-radius: 30px;
        color: #e58aa4;
        background: rgba(142,36,69,.13);
    }

    .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #d85b7d;
        box-shadow: 0 0 12px #d85b7d;
    }

    .course-label { margin: 27px 0 10px; color: #d77b96; }

    .hero h1 {
        max-width: 650px;
        margin: 0;
        font-size: clamp(30px, 4vw, 48px);
        line-height: 1.15;
        font-weight: 850;
        letter-spacing: -1.5px;
    }

    .hero h1 span, .section-heading h2 span,
    .passing-content h2 span { color: #d45a7d; }

    .hero-description {
        max-width: 570px;
        margin: 20px 0 25px;
        color: #bcb1b8;
        line-height: 1.8;
        font-size: 14px;
    }

    .hero-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 18px;
    }

    .start-button {
        display: inline-flex;
        align-items: center;
        gap: 25px;
        padding: 14px 21px;
        border-radius: 9px;
        color: white !important;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 800;
        background: linear-gradient(110deg, #84203f, #b53b61);
        box-shadow: 0 8px 28px rgba(142,36,69,.28);
        transition: .2s ease;
    }

    .start-button:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 32px rgba(181,59,97,.35);
    }

    .start-button span { font-size: 19px; }
    .secure-label { color: #b7aab2; font-size: 11px; }

    .hero-visual {
        position: relative;
        display: grid;
        place-items: center;
        min-height: 260px;
    }

    .visual-glow {
        position: absolute;
        width: 240px;
        height: 240px;
        border-radius: 50%;
        background: #922849;
        filter: blur(85px);
        opacity: .35;
    }

    .exam-emblem {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 205px;
        height: 205px;
        border: 1px solid rgba(221,117,148,.6);
        border-radius: 50%;
        background: linear-gradient(145deg, #492032, #171318 70%);
        box-shadow: 0 0 0 12px rgba(192,68,104,.06),
                    0 0 45px rgba(192,68,104,.2);
    }

    .emblem-top { color: #fff; font-size: 39px; font-weight: 900; letter-spacing: 4px; }
    .emblem-number { color: #e27b9a; font-size: 19px; font-weight: 800; }
    .emblem-line { width: 65px; height: 2px; margin: 9px 0; background: #c04468; }
    .emblem-caption { color: #c9aab6; font-size: 7px; letter-spacing: 1.5px; }

    .floating-tag {
        position: absolute;
        padding: 10px 13px;
        border: 1px solid rgba(192,68,104,.35);
        border-radius: 8px;
        color: #f0b0c2;
        background: #24151e;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
    }

    .tag-top { top: 35px; right: 0; }
    .tag-bottom { bottom: 30px; left: 0; }

    /* Examination Options */

    .exam-options {
        margin: 45px 0 60px;
    }

    .certification-group {
        margin-top: 38px;
    }

    .certification-heading {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 17px;
        padding-bottom: 15px;
        border-bottom: 1px solid var(--line-color);
    }

    .certification-index {
        display: grid;
        place-items: center;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        border: 1px solid rgba(192,68,104,.35);
        border-radius: 11px;
        color: #e58aa4;
        background: rgba(142,36,69,.15);
        font-size: 16px;
        font-weight: 900;
    }

    .certification-heading h3 {
        margin: 0 0 4px;
        font-size: 19px;
        font-weight: 850;
    }

    .certification-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 11px;
    }

    .exam-options-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .exam-option-card {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 28px;
        min-height: 245px;
        border: 1px solid rgba(192, 68, 104, .25);
        border-radius: 16px;
        background:
            radial-gradient(ellipse at 100% 0%, rgba(142, 36, 69, .22), transparent 60%),
            var(--card-bg);
        transition: .25s ease;
    }

    .exam-option-card:hover {
        transform: translateY(-5px);
        border-color: rgba(192, 68, 104, .65);
        box-shadow: 0 12px 35px rgba(142, 36, 69, .12);
    }

    .option-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        margin-bottom: 23px;
    }

    .option-number {
        color: #d45a7d;
        font-size: 27px;
        font-weight: 900;
    }

    .option-label {
        padding: 7px 11px;
        border: 1px solid rgba(192, 68, 104, .3);
        border-radius: 20px;
        color: #d77b96;
        background: rgba(142, 36, 69, .12);
        font-size: 9px;
        font-weight: 800;
        letter-spacing: 1.3px;
    }

    .exam-option-card h3 {
        margin: 0 0 10px;
        font-size: 19px;
        font-weight: 850;
    }

    .exam-option-card p {
        margin: 0 0 23px;
        max-width: 450px;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.9;
    }

    .exam-option-card .start-button {
        margin-top: auto;
    }

    .practice-card {
        background:
            radial-gradient(ellipse at 100% 0%, rgba(192, 68, 104, .25), transparent 60%),
            var(--card-bg);
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 13px;
        margin: 18px 0 65px;
    }

    .stat-card {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 21px;
        border: 1px solid var(--line-color);
        border-radius: 13px;
        background: var(--card-bg);
    }

    .stat-icon { color: #cf6686; font-size: 20px; }
    .stat-card strong { font-size: 26px; font-weight: 850; }
    .stat-card > span:last-child { color: var(--muted); font-size: 12px; }

    .section-heading { margin-bottom: 25px; }
    .section-kicker { color: #ce6686; }

    .section-heading h2, .passing-content h2, .final-cta h2 {
        margin: 9px 0;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 850;
    }

    .section-heading p, .passing-content p, .final-cta p {
        color: var(--muted);
        font-size: 13px;
        line-height: 1.8;
    }

    .rules-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .rule-card {
        padding: 23px;
        border: 1px solid var(--line-color);
        border-radius: 13px;
        background: var(--card-bg);
        transition: .2s ease;
    }

    .rule-card:hover { border-color: rgba(192,68,104,.5); transform: translateY(-3px); }

    .rule-icon {
        display: grid;
        place-items: center;
        width: 39px;
        height: 39px;
        border-radius: 10px;
        color: #e58aa4;
        background: rgba(142,36,69,.18);
        font-size: 20px;
    }

    .rule-card h3 { margin: 17px 0 8px; font-size: 15px; }
    .rule-card p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.8; }
    .rule-card.warning .rule-icon { color: #e8a36f; background: rgba(180,103,44,.13); }

    .passing-section {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 55px;
        padding: 30px;
        border: 1px solid rgba(192,68,104,.25);
        border-radius: 16px;
        background: linear-gradient(110deg, rgba(142,36,69,.17), var(--card-bg));
    }

    .passing-content { max-width: 600px; }
    .passing-score { display: flex; flex-direction: column; align-items: center; min-width: 125px; }
    .passing-score strong { color: #dc7594; font-size: 52px; line-height: 1; }
    .passing-score small { margin-top: 9px; color: var(--muted); font-size: 9px; letter-spacing: 2px; }

    .final-cta {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-top: 55px;
        padding: 43px 20px;
        border: 1px solid rgba(192,68,104,.3);
        border-radius: 18px;
        text-align: center;
        background:
            radial-gradient(ellipse at center, rgba(142,36,69,.25), transparent 70%),
            #19151a;
    }

    .final-cta p { margin: 0 0 22px; }
    .final-cta small { margin-top: 16px; color: #a99ba3; font-size: 10px; }

    @media (max-width: 750px) {
        .hero { grid-template-columns: 1fr; padding: 30px 23px; }
        .hero-visual { min-height: 230px; }
        .exam-options-grid { grid-template-columns: 1fr; }
        .stats { grid-template-columns: repeat(2, 1fr); }
        .rules-grid { grid-template-columns: 1fr; }
        .passing-section { align-items: flex-start; flex-direction: column; }
        .passing-score { align-items: flex-start; }
    }

    @media (max-width: 420px) {
        .hero h1 { font-size: 32px; }
        .hero-actions { align-items: flex-start; flex-direction: column; }
        .stat-card { padding: 15px; }
        .exam-option-card { padding: 22px; }
    }
</style>
</MainGridLayout>
